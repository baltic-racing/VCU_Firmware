#include "main.h"
#include "radio_tx.h"
#include "stdlib.h"
#include "stdbool.h"
#include "usart.h"
#include "gpio.h"

void radio_TX(USART_HandleTypeDef *husart, uint8_t *usart_exe_flag, uint8_t *TxData){
	if(*usart_exe_flag == 0){
		HAL_GPIO_WritePin(GPIOA, Tarvos_RTS_Pin, GPIO_PIN_SET);
		HAL_GPIO_WritePin(GPIOA, Tarvos_Mode_Pin, GPIO_PIN_RESET);			//Alles was über UART gesendet wird, wird 1zu1 übersetzt

		(*usart_exe_flag)++;
	}
	if(husart->gState == HAL_USART_STATE_READY){
		__HAL_LOCK(husart);
		HAL_USART_Transmit(husart);

	}else{


	}
}
