#include "can.h"

uint64_t last20 = 0;
uint64_t last100 = 0;

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
	CAN_interrupt();
}

void CAN_interrupt()
{
	if (HAL_GetTick()>= last20 + 20)
	{
		CAN_50();
		last20 = HAL_GetTick();
	}
	if (HAL_GetTick()>= last100 + 100)
	{
		CAN_10();

		HAL_GPIO_TogglePin(GPIOD, LED_Blue_Pin);	// toggle LED
		last100 = HAL_GetTick();
	}
}

void CAN_50()		// CAN Messages transmitted with 50 Hz
{
	CAN_TX(hcan1, AMS0_header, precharge_data);
}

void CAN_10(uint8_t bms_data[])		// CAN Messages transmitted with 10 Hz
{
	CAN_TX(hcan1, AMS1_header, bms_data);
}
