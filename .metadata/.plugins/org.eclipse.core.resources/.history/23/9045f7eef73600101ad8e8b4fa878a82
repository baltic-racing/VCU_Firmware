void motor_control()
{
	CAN_100();
	CAN_2();

	if(!APPS_check && HAL_GetTick() > 1000)
	{
		APPS_init();
	}

	if(APPS_check)
	{
		APPS_get();
	}

	if(ts_ready)
	{
		if(!start_motor_control && r2d_bit)
		{
			start_motor_control = 1;
			r2d_sound = 1;
			HAL_GPIO_WritePin(r2d_GPIO_Port, r2d_Pin, GPIO_PIN_SET);
			r2d_time = HAL_GetTick();

		}

		if(r2d_sound && HAL_GetTick() - r2d_time >= r2d_time_duration)
		{
			 HAL_GPIO_WritePin(r2d_GPIO_Port, r2d_Pin, GPIO_PIN_RESET);
			 r2d_sound = 0;
		}

	}
	else
	{
		//start_motor_control = 0;
	}

	e_diff();

	HAL_GPIO_WritePin(lv_active_GPIO_Port, lv_active_Pin, GPIO_PIN_SET);
	//HAL_GPIO_WritePin(r2d_GPIO_Port, r2d_Pin, GPIO_PIN_SET);
}


void e_diff()
{
	//twos complement
	if(SA >> 7 == 1)
	{
		lenkwinkel = ~SA + 1;
	}
	else
	{
		lenkwinkel = SA;
	}

	uint8_t safilter = lenkwinkel;

	if (start_motor_control)
	{
		ac_current = calculate_ac_current(current_limit, APPS_I);

		  if ((safilter) > 10)
			{
				if ((SA>>7) == 1) //negative Lenkwinkel > links
				{
					/*
					ac_current_l = ac_current * (float) ((101-(lenkwinkel))))/100;
					ac_current_r = ac_current;
					*/
					ac_current_l = (uint16_t)(ac_current * steering_ac_current_reduction_table[lenkwinkel]);
					ac_current_r = ac_current;
					brake_current_l = (uint16_t)(brake_current * steering_brake_current_reduction_table[lenkwinkel]);
					brake_current_r = brake_current;
				}
				else if((SA>>7) == 0) //positive Lenkwinkel > rechts
				{
					/*
					ac_current_r = ac_current * (float) ((101-(lenkwinkel))))/100;
					ac_current_l = ac_current;
					*/
					ac_current_r = (uint16_t)(ac_current * steering_ac_current_reduction_table[lenkwinkel]);
					ac_current_l = ac_current;
					brake_current_r = (uint16_t)(brake_current * steering_brake_current_reduction_table[lenkwinkel]);
					brake_current_l = brake_current;
				}
			}
			else
			{
				ac_current_r = ac_current;
				ac_current_l = ac_current;
			}
	}
	else
	{
		ac_current_r = 0;
		ac_current_l = 0;
	}

	AC_Current_L[0] = ac_current_l >> 8;
	AC_Current_L[1] = ac_current_l;
	AC_Current_R[0] = ac_current_r >> 8;
	AC_Current_R[1] = ac_current_r;
}

int16_t calculate_ac_current(uint16_t limit, uint16_t value)
{
	return (int16_t)((float)limit * ((float)value/100));
}
