#include "sensor_control.h"

#include "stdbool.h"

uint16_t ADC_DMS_raw = 0;
uint16_t ADC_2_V = 0;

void APPS_get()
{
	  APPS_measure();
	  APPS_calc();
}

void APPS_calc()
{

}

void APPS_measure()
{
	HAL_ADC_Start(&hadc1);
	HAL_ADC_PollForConversion(&hadc1, 10); // poll for conversion
	ADC_DMS_raw = HAL_ADC_GetValue(&hadc1); // get the adc value
	HAL_ADC_Stop(&hadc1); // stop adc

	ADC_2_V = (3.3/4095.0) * ADC_DMS_raw;
}


