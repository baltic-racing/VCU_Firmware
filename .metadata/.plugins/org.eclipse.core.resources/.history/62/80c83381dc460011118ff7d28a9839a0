/* Functions*/
void TarvosIII_Init(){

	/*
	     • Applying a low signal to the MODE_1 pin during the reset till the module is booted up,
		 starts the command mode.
		 • Applying a high signal to the MODE_1 pin during the reset till the module is booted up,
		 starts the transparent mode.
	 */
	//HAL_GPIO_WritePin(GPIOA, Tarvos_Mode_Pin, GPIO_PIN_SET);

	if(switchi >= 0){


		HAL_GPIO_WritePin(GPIOE, Tarvos_Reset_Pin, GPIO_PIN_RESET);
		HAL_Delay(10);

		/* initialize the boot pin */
		/* HIGH for Firmware update
		 * LOW for Std Mode
		 */
		HAL_GPIO_WritePin(GPIOE, Tarvos_Boot_Pin, GPIO_PIN_RESET);
		HAL_Delay(10);
		/* initialize the wakeup pin */
		HAL_GPIO_WritePin(GPIOE, Tarvos_WAKE_UP_Pin, GPIO_PIN_SET);
		HAL_Delay(10);
		/* initialize the reset pin
		 * * we have to define it as input/pull-up such that the reset button
		 * on the base PCB can pull the pin level down if the button is pressed
		 */
		//HAL_GPIO_WritePin(GPIOE, Tarvos_Reset_Pin, GPIO_PIN_SET);
		HAL_Delay(10);

		HAL_GPIO_WritePin(GPIOE, Tarvos_Reset_Pin, GPIO_PIN_SET);
		HAL_Delay(10);

		/* initialize the boot pin */
		/* HIGH for Firmware update
		 * LOW for Std Mode
		 */
		HAL_GPIO_WritePin(GPIOE, Tarvos_Boot_Pin, GPIO_PIN_SET);
		HAL_Delay(10);


		/* initialize the wakeup pin */
		HAL_GPIO_WritePin(GPIOE, Tarvos_WAKE_UP_Pin, GPIO_PIN_SET);
		HAL_Delay(10);

		switchi++;

	}

	/* empty the UART buffers */
	//FlushSerial();

	uint8_t payload_length = sizeof(payload);
		uint8_t protocol_payload_length = payload_length + 1U; // +1 for device signature (0xA2)

		// Druck skalieren → 0.1 kPa Auflösung
		/*uint16_t pressure_u16 = (uint16_t)lroundf(Pressure * 10.0f); // 0.1 kPa		//= (uint16_t)(Pressure * 10.0f);
		uint16_t temperature_u16 = (uint16_t)lroundf(Temperature * 10.0f); // 0.1 kPa
	*/
		int16_t pressure_i16 = (int16_t)lroundf(Pressure * 10.0f); // signed 0.1 kPa
		int16_t temperature_i16 = (int16_t)lroundf(Temperature * 10.0f); // signed 0.1 C
		uint16_t pressure_u16 = (uint16_t)pressure_i16;
		uint16_t temperature_u16 = (uint16_t)temperature_i16;

		uint16_t airspeed_u16 = (uint16_t)lroundf(fmaxf(airspeed, 0.0f) *10.0f);

		payload[0] = 0x03;                        // ID_Pups_I
		payload[1] = (pressure_u16 >> 8) & 0xFF;  // High-Byte
		payload[2] = 0x04;                        // ID_Pups_II
		payload[3] = pressure_u16 & 0xFF;         // Low-Byte

		payload[4] = 0x05;                        //
		payload[5] = (temperature_u16 >> 8) & 0xFF;// High-Byte
		payload[6] = 0x06;                        //
		payload[7] = temperature_u16 & 0xFF;      // Low-Byte

		payload[8] = 0x07;                        //
		payload[9] = (airspeed_u16 >> 8) & 0xFF;  // High-Byte
		payload[10] = 0x08;                        //
		payload[11] = airspeed_u16 & 0xFF;         // Low-Byte

		/*payload[2] = 0x30;			//ID_TY_APPS_I
		payload[3] = APPS_I;
		payload[4] = 0x31;			//ID_TY_APPS_II
		payload[5] = APPS_II;
		payload[6] = 0x32;			//ID_LV_motor_control
		payload[7] = motor_control;*/

		uint8_t CMD_Array[payload_length + 6U];
		CMD_Array[0] = 2;//CMD_STX;
		CMD_Array[1] = 0;//TarvosIII_CMD_DATA_REQ;		// Command-Mode of Tarvos III
		CMD_Array[2] = protocol_payload_length;		// payload length incl. device signature
		CMD_Array[3] = 0xA2;		// Device-Signature of VCU
		memcpy(&CMD_Array[4], payload, payload_length);
		FillChecksum(CMD_Array,(uint8_t)sizeof(CMD_Array));
		CMD_Array[protocol_payload_length + 4U] = CMD_ETX;

		/* now send CMD_ARRAY */
		uint8_t State = HAL_UART_Transmit(&huart1, CMD_Array, (uint8_t)sizeof(CMD_Array), 5); //5 - absolute minimum of time delay (wait for cnf)

		if (State != HAL_OK){
			uint8_t staty = HAL_UART_GetError(&huart1);
		}



	/* wait for cnf */
	HAL_Delay(50);


}

