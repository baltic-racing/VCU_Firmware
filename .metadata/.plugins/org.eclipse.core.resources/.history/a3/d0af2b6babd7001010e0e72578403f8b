void e_diff()
{
	//twos complement
	if(SA >> 7 == 1)
	{
		lenkwinkel = ~SA + 1;
	}
	else
	{
		lenkwinkel = SA;
	}

	uint8_t safilter = lenkwinkel;

	if (start_motor_control)
	{
		ac_current = calculate_ac_current(current_limit, APPS_I);
		brake_current = calculate_brake_current(brake_current_limit, brake_pressure_front);

		if ((safilter) > 10)
	    {
			if ((SA>>7) == 1) //negative Lenkwinkel > links
			{
				ac_current_l = (uint16_t)(ac_current * steering_ac_current_reduction_table[lenkwinkel]);
				ac_current_r = ac_current;
				brake_current_r = (uint16_t)(brake_current * steering_brake_current_reduction_table[lenkwinkel]);
				brake_current_l = brake_current;
			}
			else if((SA>>7) == 0) //positive Lenkwinkel > rechts
			{
				ac_current_r = (uint16_t)(ac_current * steering_ac_current_reduction_table[lenkwinkel]);
				ac_current_l = ac_current;
				brake_current_l = (uint16_t)(brake_current * steering_brake_current_reduction_table[lenkwinkel]);
				brake_current_r = brake_current;
			}
		}
		else
		{
			ac_current_r = ac_current;
			ac_current_l = ac_current;
			brake_current_r = brake_current;
			brake_current_l = brake_current;
		}
	}
	else
	{
		ac_current_r = 0;
		ac_current_l = 0;
		brake_current_r = 0;
		brake_current_l = 0;
	}

	AC_Current_L[0] = ac_current_l >> 8;
	AC_Current_L[1] = ac_current_l;
	AC_Current_R[0] = ac_current_r >> 8;
	AC_Current_R[1] = ac_current_r;

	Brake_Current_L[0] = brake_current_l >> 8;
	Brake_Current_L[1] = brake_current_l;
	Brake_Current_R[0] = brake_current_r >> 8;
	Brake_Current_R[1] = brake_current_r;
}

void dc_current_limiter_fcn()
{
	float res_dc = 0.6572;
	dc_current = dc_current_inv_l + dc_current_inv_r;
	uint16_t act_ts_voltage = (res_dc * dc_current) + (dc_voltage_inv * 10);

	if(act_ts_voltage > 5000) {
		dc_current_limit = 1500/2;
	}
	else if(act_ts_voltage > 4800) {
		dc_current_limit = 1300/2;
	}
	else if(act_ts_voltage > 4600) {
		dc_current_limit = 1000/2;
	}
	else if(act_ts_voltage > 4400) {
		dc_current_limit = 650/2;
	}
	else if(act_ts_voltage > 4200) {
		dc_current_limit = 400/2;
	}
	else if(act_ts_voltage > 4000) {
		dc_current_limit = 100/2;
	}
	else if (act_ts_voltage > 3800) {
		dc_current_limit = 100/2;
	}
	else if	(act_ts_voltage > 3600) {
		dc_current_limit = 100/2;
	}
	else
	{
		dc_current_limit = 0;
	}
}

