int16_t calculate_ac_current(uint16_t limit, uint16_t value)
{
	return (int16_t)((float)limit * ((float)value/1000));
}

int16_t calculate_brake_current(uint16_t limit, uint16_t value)
{
	return (int16_t)((float)limit * ((float)value/1000));
}

/*________________________________________________________________________________________________________*/
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim){
	if (htim->Instance == TIM2) {
		if (tim2_100ms >= 500) {
			if ((HAL_CAN_GetTxMailboxesFreeLevel(&hcan1) > 0) && (HAL_CAN_GetTxMailboxesFreeLevel(&hcan2) > 0)) {
				CAN_state_500 = 0;
			}else{
				CAN_state_500 = 1;
			}

			tim2_500ms = 0;
		}

		if (tim2_100ms >= 100) {
			if ((HAL_CAN_GetTxMailboxesFreeLevel(&hcan1) > 0) && (HAL_CAN_GetTxMailboxesFreeLevel(&hcan2) > 0)) {
				CAN_state_100 = 0;
			}else{
				CAN_state_100 = 1;
			}

			HAL_GPIO_TogglePin(GPIOD, LED_Blue_Pin);

			tim2_100ms = 0;
		}

		if (tim2_10ms >= 10) {
			if ((HAL_CAN_GetTxMailboxesFreeLevel(&hcan1) > 0) && (HAL_CAN_GetTxMailboxesFreeLevel(&hcan2) > 0)){
				CAN_state_10 = 0;
			}else{
				CAN_state_10 = 1;
			}

			tim2_10ms = 0;
		}

		if (tim2_10ms >= 1) {
			if ((HAL_CAN_GetTxMailboxesFreeLevel(&hcan1) > 0) && (HAL_CAN_GetTxMailboxesFreeLevel(&hcan2) > 0)) {
				CAN_state_1 = 0;
			}else{
				CAN_state_1 = 1;
			}

			tim2_1ms = 0;
		}

		tim2_500ms++;
		tim2_100ms++;
		tim2_10ms++;
		tim2_1ms++;
	}
}

