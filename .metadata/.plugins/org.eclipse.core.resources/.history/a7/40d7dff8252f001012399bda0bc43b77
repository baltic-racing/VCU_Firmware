#include "sensor_control.h"

uint32_t APPS_I_raw_adc = 0;
uint32_t APPS_I_adc_min = 0;
uint32_t APPS_I_adc_max = 2127;
uint32_t APPS_II_raw_adc = 0;
uint32_t APPS_II_adc_min = 0;
uint32_t APPS_II_adc_max = 1794;

uint8_t APPS_check = 0;

//APPSI 2127
//APPSII 1794

void APPS_calc()
{
	if(APPS_check)
	{
		APPS_I = (APPS_I_raw_adc-APPS_I_adc_min)/(APPS_adc_max-APPS_adc_min)*100;
	}
	else
	{
		APPS_I = 0;
	}

}

void APPS_measure()
{
	HAL_ADC_Start(&hadc1);
	HAL_ADC_PollForConversion(&hadc1, 10); // poll for conversion
	APPS_I_raw_adc = HAL_ADC_GetValue(&hadc1); // get the adc value
	HAL_ADC_Stop(&hadc1); // stop adc

	HAL_ADC_Start(&hadc2);
	HAL_ADC_PollForConversion(&hadc2, 10); // poll for conversion
	APPS_II_raw_adc = HAL_ADC_GetValue(&hadc2); // get the adc value
	HAL_ADC_Stop(&hadc2); // stop adc
}

void APPS_init()
{
	HAL_ADC_Start(&hadc1);
	HAL_ADC_PollForConversion(&hadc1, 10); // poll for conversion
	APPS_I_raw_adc = HAL_ADC_GetValue(&hadc1); // get the adc value
	HAL_ADC_Stop(&hadc1); // stop adc

	APPS_I_adc_min = APPS_I_raw_adc;

	HAL_ADC_Start(&hadc2);
	HAL_ADC_PollForConversion(&hadc2, 10); // poll for conversion
	APPS_II_raw_adc = HAL_ADC_GetValue(&hadc2); // get the adc value
	HAL_ADC_Stop(&hadc2); // stop adc

	APPS_II_adc_min = APPS_II_raw_adc;

	APPS_check = 1;

}

