/* Functions*/
void TarvosIII_Init(){

	/*
	     • Applying a low signal to the MODE_1 pin during the reset till the module is booted up,
		 starts the command mode.
		 • Applying a high signal to the MODE_1 pin during the reset till the module is booted up,
		 starts the transparent mode.
	 */
	//HAL_GPIO_WritePin(GPIOA, Tarvos_Mode_Pin, GPIO_PIN_SET);

	HAL_GPIO_WritePin(GPIOE, Tarvos_Reset_Pin, GPIO_PIN_RESET);
	HAL_Delay(10);

	/* initialize the boot pin */
	/* HIGH for Firmware update
	 * LOW for Std Mode
	 */
	HAL_GPIO_WritePin(GPIOE, Tarvos_Boot_Pin, GPIO_PIN_RESET);
	HAL_Delay(10);
	/* initialize the wakeup pin */
	HAL_GPIO_WritePin(GPIOE, Tarvos_WAKE_UP_Pin, GPIO_PIN_SET);
	HAL_Delay(10);
	/* initialize the reset pin
	 * * we have to define it as input/pull-up such that the reset button
     * on the base PCB can pull the pin level down if the button is pressed
	 */
	//HAL_GPIO_WritePin(GPIOE, Tarvos_Reset_Pin, GPIO_PIN_SET);
	HAL_Delay(10);

	HAL_GPIO_WritePin(GPIOE, Tarvos_Reset_Pin, GPIO_PIN_SET);
	HAL_Delay(10);

	/* initialize the boot pin */
	/* HIGH for Firmware update
	 * LOW for Std Mode
	 */
	HAL_GPIO_WritePin(GPIOE, Tarvos_Boot_Pin, GPIO_PIN_SET);
	HAL_Delay(10);
	/* initialize the wakeup pin */
	HAL_GPIO_WritePin(GPIOE, Tarvos_WAKE_UP_Pin, GPIO_PIN_SET);
	HAL_Delay(10);

	/* empty the UART buffers */
	//FlushSerial();

	payload[0] = 'A';

	uint8_t length = sizeof(payload);

	uint8_t CMD_Array[length + 4];
	CMD_Array[0] = CMD_STX;
	CMD_Array[1] = TarvosIII_CMD_DATA_REQ;
	CMD_Array[2] = length;
	memcpy(&CMD_Array[3], payload, length);
	FillChecksum(CMD_Array,(uint8_t)sizeof(CMD_Array));

	/* now send CMD_ARRAY */
	HAL_UART_Transmit(&huart1, CMD_Array, length, 10);
	//SendBytes(CMD_ARRAY,sizeof(CMD_ARRAY));
	Wait4CNF(CMD_WAIT_TIME, TarvosIII_CMD_DATA_CNF, CMD_Status_Success, true);
	/* wait for cnf */
	//HAL_Delay(500);
}

