/* Functions*/
static void FillChecksum(uint8_t* array, uint8_t length)
{
    if ((length >= 4) && (array[0] == CMD_STX))
    {
        uint8_t checksum = 0;
        uint8_t payload_length = array[2];
        int i = 0;
        for (i = 0;
                i < payload_length + 3;
                i++)
        {
            checksum ^= array[i];
        }
        array[payload_length + 3] = checksum;
    }
}

void Radio_transieve(){

	HAL_GPIO_WritePin(GPIOE, Tarvos_Reset_Pin, GPIO_PIN_SET);

	uint8_t length = sizeof(payload);

	// Druck skalieren → 0.1 kPa Auflösung
	uint16_t pressure_u16 = (uint16_t)(Pressure * 10.0f);

	payload[0] = 0x01;                        // ID_Pups_I
	payload[1] = (pressure_u16 >> 8) & 0xFF;  // High-Byte
	payload[2] = 0x02;                        // ID_Pups_II
	payload[3] = pressure_u16 & 0xFF;         // Low-Byte
	/*payload[2] = 0x30;			//ID_TY_APPS_I
	payload[3] = APPS_I;
	payload[4] = 0x31;			//ID_TY_APPS_II
	payload[5] = APPS_II;
	payload[6] = 0x32;			//ID_LV_motor_control
	payload[7] = motor_control;*/

	uint8_t CMD_Array[length + 4];
	CMD_Array[0] = CMD_STX;		//0x02
	CMD_Array[1] = 0x00;
	CMD_Array[2] = length;
	memcpy(&CMD_Array[3], &payload, length);
	FillChecksum(CMD_Array,(uint8_t)sizeof(CMD_Array));

	/* now send CMD_ARRAY */
	HAL_UART_Transmit(&huart1, CMD_Array, (uint8_t)sizeof(CMD_Array), 1);

	/* wait for cnf */
	HAL_Delay(5);	//absolute minimum of time delay
}
