#include "motor_control.h"
#include "stdlib.h"

extern uint8_t AC_Current_L[8];
extern uint8_t AC_Current_R[8];

uint16_t current_limit = 300;	//in Ampere
uint16_t ac_current_r = 0;
uint16_t ac_current_l = 0;
uint8_t lenkwinkel = 0;
uint8_t safilter = 0;
extern uint8_t SA;
extern uint8_t r2d_bit;
extern uint16_t APPS_I;


void motor_control()
{
	CAN_100();
	CAN_50();
	CAN_10();

	APPS_get();
	//APPS_init();
	e_diff();
}


void e_diff()
{
	uint8_t lenkwinkel = SA & 0x7F;
	uint8_t safilter = lenkwinkel;
	//1xxxxxx && 0111111

	if (r2d_bit == 1)
	{

		  if ((safilter) >10)
			{

				if ((SA>>7) == 1) //negative Lenkwinkel > links
				{
					ac_current_l = ((calculate_ac_current(current_limit, APPS_I))* (float) ((101-(lenkwinkel))))/100;
					ac_current_r =calculate_ac_current(current_limit, APPS_I);
					AC_Current_L[0] = ac_current_l >> 8;
					AC_Current_L[1] = ac_current_l;
					AC_Current_R[0] = ac_current_r >> 8;
					AC_Current_R[1] = ac_current_r;

				}
				else if((SA>>7) == 0) //positive Lenkwinkel > rechts
				{
					ac_current_r = ((calculate_ac_current(current_limit, APPS_I))* (float) ((101-(lenkwinkel))))/100;
					ac_current_l =calculate_ac_current(current_limit, APPS_I);
				}
			}
			else
			{
				ac_current_r =calculate_ac_current(current_limit, APPS_I);
				ac_current_l =calculate_ac_current(current_limit, APPS_I);
			}

	}
	else
	{
		ac_current_r = 0;
		ac_current_l = 0;
	}

}

int16_t calculate_ac_current(uint16_t limit, uint16_t value)
{
	return (int16_t)((float)limit * ((float)value/10));
}
